        <mxCell id="90" value="Public redirect flow:&#10;browser → sho.rt/{code} → nginx /api/ → gateway SetPath /api/v1/links/{code} → url-service resolve → 301 Location (Bloom filter + Redis + follower-DB read). Click is persisted + published to SQS async." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFFCC;strokeColor=#D6B656;fontSize=11;align=left;" vertex="1" parent="1">
