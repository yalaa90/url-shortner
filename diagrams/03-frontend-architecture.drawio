<mxfile host="app.diagrams.net" type="device">
  <diagram id="diagram-frontend" name="Frontend Architecture">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="21" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="41" value="api-gateway :8080 (backend — served via nginx /api/ proxy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1450" y="20" width="330" height="60" as="geometry" />
        </mxCell>

        <!-- Shell container -->
        <mxCell id="30" value="shell (host) — :4200 | prod image via Dockerfile.mfe (MFE_NAME=shell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="1080" height="700" as="geometry" />
        </mxCell>
        <mxCell id="31" value="nginx (nginx-shell.conf)&#10;^~ /api/ → api-gateway:8080&#10;^~ /remote/auth/ → auth-frontend:8080&#10;^~ /remote/links/ → links-frontend:8080&#10;^~ /remote/analytics/ → analytics-frontend:8080&#10;(^~ prefix beats static-asset regex)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;" vertex="1" parent="30">
          <mxGeometry x="300" y="180" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="32" value="bootstrap:&#10;main.ts → import('./bootstrap')&#10;standalone app · provideRouter · provideStore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="300" y="330" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="33" value="app.routes.ts:&#10;loadRemoteModule({ type:'module', remoteEntry: environment.remotes.*, exposedModule })&#10;→ plugs remote route arrays under&#10;  /auth · /dashboard · /links · /analytics/:code&#10;local features: /settings · /url-redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;" vertex="1" parent="30">
          <mxGeometry x="300" y="430" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="34" value="NgRx (root + auth):&#10;provideStore() · provideState('auth', authReducer)&#10;provideEffects([AuthEffects])·&#10;JWT token/session state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;" vertex="1" parent="30">
          <mxGeometry x="620" y="180" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="35" value="core:&#10;auth.guard · jwt storage/refresh&#10;interceptors: auth · base-url · error · loading&#10;services: link-api · analytics-api · app-config · logger · theme" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;" vertex="1" parent="30">
          <mxGeometry x="620" y="330" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="36" value="environment-driven remote URLs (fileReplacements on shell prod):&#10;dev:  env.remotes.auth = http://localhost:4201/remoteEntry.js&#10;      env.remotes.links = http://localhost:4202/remoteEntry.js&#10;      env.remotes.analytics = http://localhost:4203/remoteEntry.js&#10;prod: /remote/{auth|links|analytics}/remoteEntry.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;" vertex="1" parent="30">
          <mxGeometry x="950" y="180" width="340" height="130" as="geometry" />
        </mxCell>

        <!-- Remotes -->
        <mxCell id="50" value="auth-remote :4201&#10;webpack.config.js exposes ./authRoutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="140" width="400" height="210" as="geometry" />
        </mxCell>
        <mxCell id="51" value="app.routes.ts → authRoutes&#10;login · register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="1380" y="190" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="52" value="standalone boot (own main/bootstrap) + self-contained copies of auth service · guard · interceptor for isolated dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="1380" y="265" width="360" height="65" as="geometry" />
        </mxCell>

        <mxCell id="60" value="links-remote :4202&#10;webpack.config.js exposes ./routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="390" width="400" height="270" as="geometry" />
        </mxCell>
        <mxCell id="61" value="app.routes.ts → dashboardRoutes · linkManagementRoutes&#10;(top-level route entries carry linkStoreProviders)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="60">
          <mxGeometry x="1380" y="440" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="62" value="NgRx 'links' slice — registered lazily on route providers:&#10;providers: [provideState('links', linkReducer), provideEffects([LinkEffects])]&#10;→ self-registers inside the host store on navigation (unregisters on exit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;" vertex="1" parent="60">
          <mxGeometry x="1380" y="515" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="63" value="features: dashboard · link-list · link-create · link-detail·&#10;state: link.{actions,effects,reducer,selectors}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;" vertex="1" parent="60">
          <mxGeometry x="1380" y="610" width="360" height="55" as="geometry" />
        </mxCell>

        <mxCell id="70" value="analytics-remote :4203&#10;webpack.config.js exposes ./analyticsRoutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="700" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="71" value="app.routes.ts → analyticsRoutes&#10;click-chart · referrer-table · analytics page&#10;service-based component-local observables (no NgRx store)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="70">
          <mxGeometry x="1380" y="750" width="360" height="110" as="geometry" />
        </mxCell>

        <!-- Shared lib -->
        <mxCell id="80" value="@shared-lib — library under projects/shared-lib (path alias in tsconfig.base.json: @shared-lib → projects/shared-lib/src/public-api.ts) · bundled into every app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="880" width="1520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="81" value="models:&#10;Link · Click models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="80">
          <mxGeometry x="280" y="940" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="82" value="components (6):&#10;shared-button · shared-input · shared-table&#10;shared-dialog · shared-snackbar · copy-to-clipboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;" vertex="1" parent="80">
          <mxGeometry x="640" y="940" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="83" value="validators: url · password · alias-async&#10;pipes: date-format · truncate · object-size&#10;directives: click-outside · auto-focus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;" vertex="1" parent="80">
          <mxGeometry x="1190" y="940" width="520" height="100" as="geometry" />
        </mxCell>

        <mxCell id="90" value="Runtime singleton sharing (webpack shareAll / shared): @angular/* · @ngrx/* · rxjs · @swimlane/ngx-charts. Remotes expose ROUTE MODULES (not components); the host composes them via loadRemoteModule. Expose paths are workspace-root-relative (./projects/&lt;mfe&gt;/src/app/app.routes.ts)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="240" y="1120" width="760" height="100" as="geometry" />
        </mxCell>
        <mxCell id="91" value="⚠ Known gap (Helm/K8s): shell nginx /remote/* upstream hostnames are baked into the image as auth-frontend / links-frontend / analytics-frontend (docker-compose names). In-cluster service names differ → /remote/* proxy must be re-pointed in the cluster." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFCCCC;strokeColor=#B85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1120" width="720" height="100" as="geometry" />
        </mxCell>
        <mxCell id="92" value="Ports: dev &amp; docker — shell 4200 · auth-remote 4201 · links-remote 4202 · analytics-remote 4203 (containers map host:X020 → container 8080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="1250" width="760" height="50" as="geometry" />
        </mxCell>

