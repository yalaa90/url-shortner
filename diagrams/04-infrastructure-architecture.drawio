        <mxCell id="65" value="pgadmin 5050→80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="60">
          <mxGeometry x="890" y="1440" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="66" value="Backend apps (SPRING_PROFILES_ACTIVE=docker):&#10;url-service 8081 · analytics-service 8082 · user-service 8083 · api-gateway 8080&#10;(api-gateway depends on redis + all 3 services)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;" vertex="1" parent="60">
          <mxGeometry x="80" y="1530" width="620" height="90" as="geometry" />
        </mxCell>
        <mxCell id="67" value="Frontend MFEs (Dockerfile.mfe):&#10;shell-frontend 4200 · auth-frontend 4201 · links-frontend 4202 · analytics-frontend 4203&#10;shell nginx: /remote/* → remote containers · /api/ → api-gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;" vertex="1" parent="60">
