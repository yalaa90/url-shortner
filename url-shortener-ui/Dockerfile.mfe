# Multi-stage: build Angular MFE workspace, serve individual projects
FROM node:22-alpine AS build
WORKDIR /app
ARG MFE_NAME=shell
COPY package.json package-lock.json ./
COPY scripts/ scripts/
RUN npm ci
COPY . .
RUN npx ng build shared-lib --configuration=production
RUN npx ng build ${MFE_NAME} --configuration=production

FROM nginx:1.27-alpine AS runtime
ARG MFE_NAME=shell
# default.conf initially = remote config; overwritten with the shell config below
COPY nginx-shell.conf /etc/nginx/conf.d/shell.conf
COPY nginx-remote.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/${MFE_NAME} /usr/share/nginx/html
RUN if [ "${MFE_NAME}" = "shell" ]; then \
      cp /etc/nginx/conf.d/shell.conf /etc/nginx/conf.d/default.conf; \
    fi \
    && rm -f /etc/nginx/conf.d/shell.conf
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1