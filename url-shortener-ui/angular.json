            "index": "projects/analytics-remote/src/index.html",
            "main": "projects/analytics-remote/src/main.ts",
            "polyfills": "zone.js",
            "tsConfig": "projects/analytics-remote/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [],
            "styles": [
              "projects/analytics-remote/src/styles.scss"
            ],
            "scripts": [],
            "commonChunk": false
          },
          "configurations": {
            "production": {
